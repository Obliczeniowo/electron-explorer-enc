{
  "name": "file-explorer",
  "version": "1.0.6",
  "main": "main.js",
  "author": "Krzysztof Zajączkowski",
  "description": "Explorer application to explore files on computer desktop with possibility to open jpg, jpeg, gif, tiff, png graphics files and txt, js, json, ts, tsx, html, css and scss files. Running ocr over folder with graphics files. Running filters over graphics files in folder. It's let you see preview and edit some gimp gradients, exporting them to svg file and retrieving from svg file ass well.",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --open",
    "build": "ng build  --configuration production --base-href=./",
    "start:electron": "npm run copy-assets && ng build --base-href ./ && electron .",
    "start:electron-prod": "npm run copy-assets && ng build --configuration production --base-href=./ && electron .",
    "package-mac": "electron-packager . --overwrite --platform=darwin --arch=x64 --icon=assets/icons/mac/icon.icns --prune=true --out=release-builds",
    "package-win": "electron-packager . explorer --overwrite --asar=true --platform=win32 --arch=ia32 --icon=electron-assets/icons/app-electron-icon.ico --prune=true --out=release-builds --version-string.CompanyName=CE --version-string.FileDescription=CE --version-string.ProductName=\"Explorer App\"",
    "package-linux": "electron-packager . explorer --overwrite --asar=true --platform=linux --arch=x64 --icon=assets/icons/app-electron-icon.png --prune=true --out=release-builds",
    "build:electron": "ng build --configuration production --base-href=./ && cd node_modules/trash && npm install && cd ../../ && electron-builder build --win",
    "instal": "node instal.js",
    "reinstal": "npm i && npm run instal",
    "copy-assets": "node ./node_modules/@obliczeniowo/elementary/assets/scripts/copy.js ./src/assets/",
    "encrypt": "cd ./enc && node batch-encdec.js ../config-encrypt.json",
    "decrypt": "cd ./enc && node batch-encdec.js ../config-decrypt.json"
  },
  "devDependencies": {
    "@angular/build": "^21.0.3",
    "concurrently": "^7.6.0",
    "wait-on": "^7.0.1"
  },
  "dependencies": {
    "@angular/animations": "^21.0.4",
    "@angular/cdk": "^20.2.4",
    "@angular/cli": "^21.0.3",
    "@angular/common": "^21.0.4",
    "@angular/compiler": "^21.0.4",
    "@angular/core": "^21.0.4",
    "@angular/forms": "^21.0.4",
    "@angular/platform-browser": "^21.0.4",
    "@angular/platform-browser-dynamic": "^21.0.4",
    "@angular/router": "^21.0.4",
    "@fortawesome/angular-fontawesome": "^3.0.0",
    "@fortawesome/fontawesome-svg-core": "^6.5.0",
    "@fortawesome/free-solid-svg-icons": "^6.5.0",
    "docx": "^9.5.1",
    "flv.js": "^1.6.2",
    "is-path-inside": "^4.0.0",
    "jspdf": "^2.5.1",
    "mammoth": "^1.11.0",
    "monaco-editor": "^0.53.0",
    "music-metadata": "^11.9.0",
    "ng2-charts": "^8.0.0",
    "ng2-pdf-viewer": "^10.4.0",
    "ngx-monaco-editor-v2": "^20.0.0",
    "rxjs": "^7.8.0",
    "zone.js": "^0.15.1"
  }
}